<mxfile host="gemini-cli" version="1.0">
  <diagram id="bookings-diagram" name="Bookings Page">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Main Page View -->
        <mxCell id="main-page" value="BookingsPage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
            <mxGeometry x="40" y="40" width="1000" height="880" as="geometry" />
        </mxCell>
        
        <mxCell id="page-header" value="Header" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="main-page">
            <mxGeometry x="20" y="40" width="960" height="60" as="geometry" />
        </mxCell>
        <mxCell id="page-title" value="&lt;b&gt;Бронирования&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacing=4;" vertex="1" parent="page-header">
            <mxGeometry x="20" y="15" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="refresh-btn" value="Обновить" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#b3e5fc;" vertex="1" parent="page-header">
            <mxGeometry x="720" y="10" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="add-btn" value="Создать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#c8e6c9;" vertex="1" parent="page-header">
            <mxGeometry x="840" y="10" width="100" height="40" as="geometry" />
        </mxCell>

        <mxCell id="kpi-cards" value="KPI Cards" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="main-page">
            <mxGeometry x="20" y="110" width="960" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kpi-1" value="Всего" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;" vertex="1" parent="kpi-cards">
            <mxGeometry x="20" y="10" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kpi-2" value="Ожидают" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3cd;" vertex="1" parent="kpi-cards">
            <mxGeometry x="250" y="10" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kpi-3" value="Подтверждено" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;" vertex="1" parent="kpi-cards">
            <mxGeometry x="480" y="10" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="kpi-4" value="Выручка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;" vertex="1" parent="kpi-cards">
            <mxGeometry x="710" y="10" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="content-area" value="Content Area" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;dashed=1;" vertex="1" parent="main-page">
            <mxGeometry x="20" y="220" width="960" height="640" as="geometry" />
        </mxCell>

        <mxCell id="tabs" value="View Tabs" style="shape=flexArrow;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="content-area">
          <mxGeometry x="20" y="20" width="920" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tab-table" value="Таблица" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="tabs">
            <mxGeometry x="10" y="5" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tab-calendar" value="Календарь" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="tabs">
            <mxGeometry x="120" y="5" width="100" height="30" as="geometry" />
        </mxCell>

        <mxCell id="filters" value="Filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;" vertex="1" parent="content-area">
            <mxGeometry x="20" y="70" width="920" height="60" as="geometry" />
        </mxCell>
        <mxCell id="filter-1" value="Статус" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="filters"><mxGeometry x="10" y="10" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="filter-2" value="Тип" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="filters"><mxGeometry x="140" y="10" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="filter-3" value="Поиск" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="filters"><mxGeometry x="270" y="10" width="200" height="40" as="geometry"/></mxCell>
        <mxCell id="filter-4" value="Дата" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="filters"><mxGeometry x="480" y="10" width="200" height="40" as="geometry"/></mxCell>
        
        <mxCell id="view-container" value="View Container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;" vertex="1" parent="content-area">
            <mxGeometry x="20" y="140" width="920" height="480" as="geometry" />
        </mxCell>
        
        <mxCell id="table-view" value="BookingTable" style="swimlane;startSize=20;" vertex="1" parent="view-container">
          <mxGeometry width="920" height="480" as="geometry" />
        </mxCell>
        <mxCell id="calendar-view" value="BookingCalendar" style="swimlane;startSize=20;" vertex="1" parent="view-container">
          <mxGeometry width="920" height="480" as="geometry" />
        </mxCell>
        
        <!-- Modals -->
        <mxCell id="booking-form-modal" value="BookingForm (Dialog)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#b3e5fc;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="40" width="400" height="500" as="geometry" />
        </mxCell>
        <mxCell id="booking-details-modal" value="BookingDetails (Dialog)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#c8e6c9;fontStyle=1;align=center;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1080" y="560" width="400" height="500" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="edge-add" value="opens" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="add-btn" target="booking-form-modal">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
                <mxPoint x="980" y="100" as="sourcePoint"/>
                <mxPoint x="1080" y="290" as="targetPoint"/>
            </mxGeometry>
        </mxCell>
        <mxCell id="edge-edit" value="opens" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="table-view" target="booking-form-modal">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
                <mxPoint x="980" y="500" as="sourcePoint"/>
                <mxPoint x="1080" y="290" as="targetPoint"/>
                <Array as="points"><mxPoint x="1040" y="500"/></Array>
            </mxGeometry>
        </mxCell>
        <mxCell id="edge-view-table" value="opens" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="table-view" target="booking-details-modal">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
                <mxPoint x="540" y="800" as="sourcePoint"/>
                <mxPoint x="1080" y="500" as="targetPoint"/>
                <Array as="points"><mxPoint x="1040" y="800"/></Array>
            </mxGeometry>
        </mxCell>
        <mxCell id="edge-view-calendar" value="opens" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="calendar-view" target="booking-details-modal">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
                <mxPoint x="540" y="840" as="sourcePoint"/>
                <mxPoint x="1080" y="810" as="targetPoint"/>
            </mxGeometry>
        </mxCell>
        <mxCell id="edge-form-success" value="onSuccess()" style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="booking-form-modal" target="main-page">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
                <mxPoint x="1080" y="290" as="sourcePoint"/>
                <mxPoint x="1000" y="480" as="targetPoint"/>
                <Array as="points"><mxPoint x="1040" y="290"/></Array>
            </mxGeometry>
        </mxCell>
         <mxCell id="edge-details-action" value="onConfirm() etc." style="edgeStyle=elbowEdgeStyle;elbow=horizontal;endArrow=classic;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="booking-details-modal" target="main-page">
            <mxGeometry width="50" height="50" relative="1" as="geometry">
                <mxPoint x="1080" y="810" as="sourcePoint"/>
                <mxPoint x="1000" y="480" as="targetPoint"/>
                <Array as="points"><mxPoint x="1040" y="810"/></Array>
            </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
