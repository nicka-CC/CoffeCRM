<mxfile host="gemini-cli" version="1.0">
  <diagram id="dashboard-diagram" name="Dashboard Page">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Layout -->
        <mxCell id="layout" value="Layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1160" height="760" as="geometry" />
        </mxCell>

        <!-- Sidebar -->
        <mxCell id="sidebar" value="Sidebar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#b3e5fc;" vertex="1" parent="layout">
          <mxGeometry x="20" y="40" width="200" height="700" as="geometry" />
        </mxCell>
        <mxCell id="sidebar-title" value="CoffeeCRM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=16;" vertex="1" parent="sidebar">
            <mxGeometry x="10" y="10" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="nav-dashboard" value="Дашборд" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="sidebar">
            <mxGeometry x="20" y="60" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nav-users" value="Пользователи" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="sidebar">
            <mxGeometry x="20" y="90" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nav-branches" value="Филиалы" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="sidebar">
            <mxGeometry x="20" y="120" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nav-products" value="Товары" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="sidebar">
            <mxGeometry x="20" y="150" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="nav-more" value="..." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="sidebar">
            <mxGeometry x="20" y="180" width="160" height="20" as="geometry" />
        </mxCell>

        <!-- Main Content -->
        <mxCell id="main-content" value="Main Content" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="layout">
          <mxGeometry x="240" y="40" width="900" height="700" as="geometry" />
        </mxCell>

        <!-- AppBar -->
        <mxCell id="appbar" value="AppBar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#d1c4e9;" vertex="1" parent="main-content">
          <mxGeometry width="900" height="60" as="geometry" />
        </mxCell>
        <mxCell id="user-menu" value="User Menu" style="shape=umlActor;verticalAlign=top;align=center;html=1;" vertex="1" parent="appbar">
          <mxGeometry x="840" y="15" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="user-menu-edge" style="edgeStyle=none;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="appbar" source="user-menu-popup" target="user-menu">
            <mxGeometry relative="1" as="geometry">
                <mxPoint x="800" y="110" as="sourcePoint"/>
            </mxGeometry>
        </mxCell>
        <mxCell id="user-menu-popup" value="My Account&lt;hr&gt;Logout" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=4;" vertex="1" parent="appbar">
            <mxGeometry x="740" y="60" width="120" height="50" as="geometry"/>
        </mxCell>
        

        <!-- Page Content -->
        <mxCell id="page-content" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="main-content">
          <mxGeometry y="60" width="900" height="640" as="geometry" />
        </mxCell>
        <mxCell id="page-title" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;Главная панель управления" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacing=4;" vertex="1" parent="page-content">
            <mxGeometry x="20" y="20" width="300" height="40" as="geometry" />
        </mxCell>

        <mxCell id="period-filter" value="Period Filter (Select)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#b3e5fc;" vertex="1" parent="page-content">
          <mxGeometry x="760" y="20" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- KPI Grid -->
        <mxCell id="kpi-grid" value="KPIs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="page-content">
          <mxGeometry x="20" y="80" width="860" height="120" as="geometry" />
        </mxCell>
        <mxCell id="kpi-revenue" value="Выручка&lt;br&gt;&lt;b&gt;{value}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ffe0b2;align=center;spacing=4;" vertex="1" parent="kpi-grid">
          <mxGeometry width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kpi-orders" value="Заказов&lt;br&gt;&lt;b&gt;{value}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#c8e6c9;align=center;spacing=4;" vertex="1" parent="kpi-grid">
          <mxGeometry x="220" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kpi-avg-check" value="Средний чек&lt;br&gt;&lt;b&gt;{value}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#d1c4e9;align=center;spacing=4;" vertex="1" parent="kpi-grid">
          <mxGeometry x="440" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="kpi-new-customers" value="Новых клиентов&lt;br&gt;&lt;b&gt;{value}&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#b3e5fc;align=center;spacing=4;" vertex="1" parent="kpi-grid">
          <mxGeometry x="660" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Charts Grid -->
        <mxCell id="charts-grid" value="Charts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="page-content">
          <mxGeometry x="20" y="220" width="860" height="380" as="geometry" />
        </mxCell>
        <mxCell id="sales-chart" value="График продаж (LineChart)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#f8bbd0;" vertex="1" parent="charts-grid">
          <mxGeometry width="540" height="360" as="geometry" />
        </mxCell>
        <mxCell id="top-products" value="ТОП товаров (List)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f8e9;strokeColor=#dcedc8;" vertex="1" parent="charts-grid">
          <mxGeometry x="560" width="300" height="360" as="geometry" />
        </mxCell>
        
        <mxCell id="product-item-1" value="1. Product A" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="top-products">
            <mxGeometry x="20" y="40" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="product-item-2" value="2. Product B" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="top-products">
            <mxGeometry x="20" y="80" width="260" height="30" as="geometry" />
        </mxCell>
        <mxCell id="product-item-3" value="3. Product C" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="top-products">
            <mxGeometry x="20" y="120" width="260" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
