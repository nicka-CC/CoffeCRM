<mxfile host="gemini-cli" version="1.0">
  <diagram id="analytics-diagram" name="Analytics Page">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Page Wrapper -->
        <mxCell id="page-wrapper" value="Layout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
            <mxGeometry x="20" y="20" width="1360" height="840" as="geometry" />
        </mxCell>
        <mxCell id="main-content-area" value="Main Content (Analytics)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="page-wrapper">
          <mxGeometry x="240" y="40" width="1100" height="780" as="geometry" />
        </mxCell>

        <!-- Header -->
        <mxCell id="header" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="main-content-area">
          <mxGeometry y="0" width="1100" height="120" as="geometry" />
        </mxCell>
        <mxCell id="page-title" value="&lt;b&gt;Аналитика&lt;/b&gt;&lt;br&gt;Анализ продаж и статистика" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacing=4;" vertex="1" parent="header">
            <mxGeometry x="20" y="20" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="refresh-btn" value="Обновить" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#b3e5fc;" vertex="1" parent="header">
            <mxGeometry x="840" y="20" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="export-btn" value="Экспорт отчета" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#c8e6c9;" vertex="1" parent="header">
            <mxGeometry x="960" y="20" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Filters -->
        <mxCell id="filters" value="Filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#e0e0e0;dashed=1;" vertex="1" parent="header">
            <mxGeometry x="20" y="70" width="1060" height="60" as="geometry" />
        </mxCell>
        <mxCell id="period-filter" value="Период (Select)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#ccc;" vertex="1" parent="filters">
          <mxGeometry x="20" y="10" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="from-date" value="С (Date)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#ccc;" vertex="1" parent="filters">
          <mxGeometry x="180" y="10" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="to-date" value="По (Date)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#ccc;" vertex="1" parent="filters">
          <mxGeometry x="320" y="10" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Body -->
        <mxCell id="body" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="main-content-area">
          <mxGeometry y="130" width="1100" height="650" as="geometry" />
        </mxCell>

        <!-- Chart Grid -->
        <mxCell id="chart-grid" value="Charts Grid" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;" vertex="1" parent="body">
          <mxGeometry x="20" y="0" width="1060" height="640" as="geometry" />
        </mxCell>
        
        <!-- Sales Dynamics -->
        <mxCell id="sales-dynamics-card" value="Динамика продаж" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#e1bee7;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="chart-grid">
            <mxGeometry y="0" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sales-dynamics-chart" value="LineChart (Выручка, Заказы)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="sales-dynamics-card">
            <mxGeometry x="20" y="40" width="480" height="240" as="geometry" />
        </mxCell>

        <!-- Top Customers -->
        <mxCell id="top-customers-card" value="ТОП клиентов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#c8e6c9;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="chart-grid">
            <mxGeometry x="540" y="0" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="top-customers-chart" value="BarChart (Выручка по клиентам)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="top-customers-card">
            <mxGeometry x="20" y="40" width="480" height="240" as="geometry" />
        </mxCell>

        <!-- Branch Sales -->
        <mxCell id="branch-sales-card" value="Продажи по филиалам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#b3e5fc;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="chart-grid">
            <mxGeometry y="320" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="branch-sales-chart" value="PieChart (Доля выручки)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="branch-sales-card">
            <mxGeometry x="20" y="40" width="480" height="240" as="geometry" />
        </mxCell>
        
        <!-- Peak Hours -->
        <mxCell id="peak-hours-card" value="Пиковые часы заказов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ffe0b2;fontStyle=1;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="chart-grid">
            <mxGeometry x="540" y="320" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="peak-hours-chart" value="BarChart (Заказы по часам)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="peak-hours-card">
            <mxGeometry x="20" y="40" width="480" height="240" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
