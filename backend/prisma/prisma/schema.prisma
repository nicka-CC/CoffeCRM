generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = "postgres://neondb_owner:npg_4p5RYihEZesm@ep-raspy-silence-a10u9qpl-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
  url      = "postgresql://postgres:nikita12345@localhost:5432/CoffeCRM?schema=public"
}

// ---------- Основные типы ----------
enum Role {
  ADMIN
  READ
  EDITE
  WRITE
}

enum OrderStatus {
  NEW
  IN_PROGRESS
  READY
  COMPLETED
  CANCELED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum BookingType {
  TABLE
  EVENT
  MEETING
  PRIVATE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  BONUS
  FREE
}

enum TransactionType {
  INCOME
  EXPENSE
  WRITE_OFF
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  icon      String?
  password  String
  fullName  String
  role      Role     @default(READ)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // связи
  employee Employee?
  customer Customer?
}

model Employee {
  id       String   @id @default(uuid())
  userId   String   @unique
  position String
  salary   Float?
  hiredAt  DateTime @default(now())
  kpis     Kpi[]

  user      User      @relation(fields: [userId], references: [id])
  branch    Branch?   @relation(fields: [branchId], references: [id])
  branchId  String?
  bookings  Booking[] // бронирования, которые обслуживает сотрудник
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Kpi {
  id         String   @id @default(uuid())
  employeeId String
  metric     String
  value      Float
  date       DateTime @default(now())

  employee  Employee @relation(fields: [employeeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  address     String
  city        String
  region      String?
  postalCode  String?
  country     String   @default("Россия")
  phone       String?
  email       String?
  website     String?
  latitude    Float?
  longitude   Float?
  timezone    String   @default("Europe/Moscow")
  openTime    String?
  closeTime   String?
  isActive    Boolean  @default(true)
  managerName String?
  managerPhone String?
  area        Float?   // площадь в м²
  capacity    Int?     // вместимость
  description String?
  createdAt   DateTime @default(now())

  employees Employee[]
  stocks    Stock[]
  orders    Order[]
  bookings  Booking[]
  updatedAt DateTime   @updatedAt
}

model Product {
  id            String   @id @default(uuid())
  name          String
  nameEn        String?
  icon          String?
  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    String
  price         Float
  cost          Float?
  oldPrice      Float?
  sku           String?  @unique // артикул
  barcode       String?  @unique // штрихкод
  unit          String   @default("шт") // единица измерения
  weight        Float?   // вес в граммах
  volume        Float?   // объем в мл
  calories      Int?     // калории
  proteins      Float?   // белки
  fats          Float?   // жиры
  carbs         Float?   // углеводы
  description   String?
  composition   String?  // состав
  allergens     String?  // аллергены
  shelfLife     Int?     // срок годности в днях
  storageTemp   String?  // температура хранения
  imageUrl      String?
  images        String[] // массив дополнительных изображений
  isActive      Boolean  @default(true)
  isPopular     Boolean  @default(false)
  isNew         Boolean  @default(false)
  sortOrder     Int      @default(0)
  tags          String[] // теги

  stocks     Stock[]
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String
  icon      String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Stock {
  id              String @id @default(uuid())
  branchId        String
  productId       String
  quantity        Int    @default(0)
  reserved        Int    @default(0) // зарезервировано
  minQuantity     Int    @default(0) // минимальный остаток
  maxQuantity     Int?   // максимальный остаток
  reorderPoint    Int?   // точка заказа
  location        String? // место хранения на складе
  batchNumber     String? // номер партии
  expiryDate      DateTime? // срок годности
  purchasePrice   Float? // закупочная цена
  supplier        String? // поставщик
  lastRestockedAt DateTime? // последнее пополнение
  notes           String? // заметки

  branch       Branch             @relation(fields: [branchId], references: [id])
  product      Product            @relation(fields: [productId], references: [id])
  transactions StockTransaction[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([branchId, productId])
}

model StockTransaction {
  id          String          @id @default(uuid())
  stockId     String
  type        TransactionType
  quantity    Int
  date        DateTime        @default(now())
  price       Float? // цена за единицу
  totalPrice  Float? // общая стоимость
  reason      String? // причина операции
  document    String? // номер документа (накладная, счет и т.д.)
  supplier    String? // поставщик
  batchNumber String? // номер партии
  expiryDate  DateTime? // срок годности для этой партии
  employeeId  String? // кто провел операцию
  notes       String? // примечания

  stock     Stock    @relation(fields: [stockId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         String      @id @default(uuid())
  branchId   String
  customerId String?
  status     OrderStatus @default(NEW)
  total      Float
  createdAt  DateTime    @default(now())

  branch    Branch      @relation(fields: [branchId], references: [id])
  customer  Customer?   @relation(fields: [customerId], references: [id])
  items     OrderItem[]
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float

  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id              String    @id @default(uuid())
  userId          String    @unique
  bonus           Int       @default(0) // текущий баланс бонусов
  totalSpent      Float     @default(0) // общая сумма покупок
  totalOrders     Int       @default(0) // общее количество заказов
  averageCheck    Float?    // средний чек
  lastOrderDate   DateTime? // дата последнего заказа
  favoriteProduct String?   // любимый товар (productId)
  favoriteBranch  String?   // любимый филиал (branchId)
  discountPercent Float?    @default(0) // процент скидки
  vipStatus       Boolean   @default(false) // VIP статус
  notes           String?   // заметки о клиенте
  tags            String[]  // теги для сегментации
  source          String?   // источник (сайт, приложение, офлайн)
  referralCode    String?   @unique // реферальный код
  referredBy      String?   // кто привел (customerId)
  birthday        DateTime? // день рождения
  preferences     String?   // предпочтения (JSON)
  orders          Order[]
  bookings        Booking[]
  bonusHistory    BonusTransaction[] // история бонусных операций

  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BonusTransaction {
  id          String   @id @default(uuid())
  customerId String
  type        String   // EARNED, SPENT, EXPIRED, ADJUSTED
  amount      Int       // количество бонусов
  orderId     String?  // связанный заказ
  description String?   // описание операции
  expiresAt   DateTime? // срок действия бонусов
  customer   Customer  @relation(fields: [customerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id              String        @id @default(uuid())
  branchId        String
  customerId      String
  employeeId      String? // кто обслуживает
  title           String? // название/описание
  description     String? // описание события
  date            DateTime // дата бронирования
  timeFrom        DateTime // время начала
  timeTo          DateTime // время окончания
  duration        Int? // продолжительность в минутах
  type            BookingType  @default(TABLE) // тип бронирования
  status          BookingStatus @default(PENDING)
  guestsCount     Int          @default(1) // количество гостей
  tableNumber     String? // номер стола
  contactName     String? // контактное имя (если не клиент)
  contactPhone    String? // контактный телефон
  contactEmail    String? // контактный email
  specialRequests String? // особые пожелания
  notes           String? // внутренние заметки
  price           Float? // стоимость бронирования
  deposit         Float? // предоплата
  paymentMethod   PaymentMethod? // способ оплаты
  isPaid          Boolean       @default(false) // оплачено ли
  isConfirmed     Boolean       @default(false) // подтверждено клиентом
  confirmationCode String? @unique // код подтверждения
  reminderSent    Boolean       @default(false) // отправлено ли напоминание
  reminderDate    DateTime? // когда отправить напоминание
  cancelledAt     DateTime? // когда отменено
  cancelledBy     String? // кто отменил (userId)
  cancellationReason String? // причина отмены
  completedAt     DateTime? // когда завершено
  recurrenceRule  String? // правило повтора (RRULE format)
  parentBookingId String? // ID родительского бронирования для повторяющихся
  source          String? // источник бронирования (сайт, телефон, приложение)
  tags            String[] // теги для фильтрации

  branch    Branch    @relation(fields: [branchId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Report {
  id        String   @id @default(uuid())
  type      String
  period    String
  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Company {
  id              String   @id @default(uuid())
  icon            String?
  name            String
  description     String?
  legalName       String?  // юридическое название
  inn             String?  // ИНН
  kpp             String?  // КПП
  ogrn            String?  // ОГРН
  address         String?  // юридический адрес
  actualAddress   String?  // фактический адрес
  phone           String?  // телефон
  email           String?  // email
  website         String?  // сайт
  director        String?  // директор
  accountant      String?  // бухгалтер
  bankName        String?  // банк
  bankAccount     String?  // расчетный счет
  bankBik         String?  // БИК
  taxSystem       String?  // система налогообложения
  logo            String?  // логотип
  settings        String?  // настройки (JSON)
  timezone        String   @default("Europe/Moscow")
  currency        String   @default("RUB")
  language        String   @default("ru")
  createdAt       DateTime @default(now())

  PaymentSettings PaymentSettings[]
  Integration     Integration[]
  updatedAt       DateTime @updatedAt
}

model PaymentSettings {
  id          String   @id @default(uuid())
  icon        String?
  provider    String   // SBERBANK, YOOKASSA, TINKOFF, etc.
  name        String?  // название настройки
  apiKey      String   // API ключ
  secretKey   String?  // секретный ключ
  merchantId  String?  // ID мерчанта
  terminalId  String?  // ID терминала
  isActive    Boolean  @default(true)
  isTest      Boolean  @default(false) // тестовый режим
  commission  Float?   // комиссия в процентах
  minAmount   Float?   // минимальная сумма
  maxAmount   Float?   // максимальная сумма
  webhookUrl  String?  // URL для webhook
  settings    String?  // дополнительные настройки (JSON)
  companyId   String   @unique
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Integration {
  id          String   @id @default(uuid())
  icon        String?
  name        String   // название интеграции
  type        String   // тип (CRM, ACCOUNTING, DELIVERY, SMS, EMAIL, etc.)
  provider    String?  // провайдер (AMOCRM, 1C, etc.)
  apiKey      String?  // API ключ
  apiSecret   String?  // секретный ключ
  apiUrl      String?  // URL API
  webhookUrl  String?  // URL для webhook
  isActive    Boolean  @default(true)
  isTest      Boolean  @default(false)
  settings    String?  // настройки (JSON)
  lastSyncAt  DateTime? // последняя синхронизация
  syncStatus  String?  // статус синхронизации
  errorMessage String? // сообщение об ошибке
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
